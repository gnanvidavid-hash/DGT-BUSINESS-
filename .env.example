# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FEDAPAY_PUBLIC_KEY: Clé publique FedaPay (mode sandbox/test uniquement côté app Android).
# Configurez cette clé dans le panneau Secrets de Google AI Studio.
# Ne placez JAMAIS la clé secrète FedaPay ou le secret webhook dans l'application Android.
FEDAPAY_PUBLIC_KEY=pk_sandbox_REPLACE_WITH_YOUR_PUBLIC_KEY
